{
  "name": "@mms/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "seed": "tsx src/db/seed.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",

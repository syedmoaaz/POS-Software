# Mega Modern Solutions POS — environment example
NODE_ENV=development
PORT=4000

# MongoDB Atlas or local (use replica set in production for multi-doc transactions)
MONGODB_URI=mongodb://127.0.0.1:27017/mega_modern_pos
# Vitest integration DB (optional override)
# MONGODB_URI_TEST=mongodb://127.0.0.1:27017/mega_modern_pos_test

# Comma-separated browser origins allowed for cookie auth
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175
# Production example:
# CORS_ORIGIN=https://pos.megamodern.solutions,https://pos.vercel.app

# Optional cookie domain for production shared subdomain
# COOKIE_DOMAIN=.megamodern.solutions

# MUST change in production (use long random values, e.g. openssl rand -hex 32)
ACCESS_TOKEN_SECRET=dev-access-secret-change-me
REFRESH_TOKEN_SECRET=dev-refresh-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

LOG_LEVEL=info

# --- apps/web (Vercel) ---
# VITE_API_URL=https://api.example.com

# --- apps/print-bridge (store PC only) ---
# BRIDGE_PORT=9100
# BRIDGE_TOKEN=change-me
# BRIDGE_MODE=simulate
# PRINTER_HOST=
# PRINTER_PORT=9100
